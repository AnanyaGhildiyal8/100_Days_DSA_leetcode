#include<stdio.h>
int maxSubArray(int* nums, int numsSize) {
    int currentSum = nums[0];
    int bestSum = nums[0];
    
    for (int i = 1; i < numsSize; i++) {
        if (currentSum + nums[i] > nums[i]) {
            currentSum = currentSum + nums[i];
        } else {
            currentSum = nums[i];
        }
        
        if (currentSum > bestSum) {
            bestSum = currentSum;
        }
    }
    
    return bestSum;
}
