#include<stdio.h>
int maxProfit(int* prices, int pricesSize) {
    int a = prices[0];
    int b = 0;
    
    for (int i = 1; i < pricesSize; i++) {
        if (prices[i] < a) {
            a = prices[i];
        }
        if (prices[i] - a > b) {
            b = prices[i] - a;
        }
    }
    
    return b;
}
