#include<stdio.h>
void moveZeroes(int* nums, int numsSize) {
    int lastNonZero = 0;
    
    for (int i = 0; i < numsSize; i++) {
        if (nums[i] != 0) {
            int temp = nums[lastNonZero];
            nums[lastNonZero] = nums[i];
            nums[i] = temp;
            lastNonZero++;
        }
    }
}
